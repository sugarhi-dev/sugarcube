POSTGRES_USER=sugarcube
POSTGRES_PASSWORD=
POSTGRES_DB=sugarcube

KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=sugarcube-test
S3_ENDPOINT=https://sugarcube-test.s3.us-east-2.amazonaws.com

OAUTH_CLIENT_ID=sugarcube
OAUTH_CLIENT_SECRET=

# Keycloak client sugarcube_admin. Redirect URI: https://test.sugarcube.tv/admin/auth/admin/callback
OAUTH_ADMIN_CLIENT_SECRET=

KEYCLOAK_ISSUER=https://test.sugarcube.tv/idp/realms/sugarcube
KEYCLOAK_JWKS_URL=http://keycloak:8080/idp/realms/sugarcube/protocol/openid-connect/certs
PORT=3000

# Filled by ensure-secrets.sh once POSTGRES_PASSWORD is known
DATABASE_URL=

# Required when EmailService is constructed.
RESEND_API_KEY=
EMAIL_FROM="Sugarcube <admin@email.sugarcube.tv>"

# Cloudflare Stream. Leave blank to skip copying uploads. When the webhook secret is set,
# POST /api/cloudflare/stream requires a valid Webhook-Signature header.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_STREAM_WEBHOOK_SECRET=
