{
  "name": "sugarcube",
  "private": true,
  "type": "module",
  "workspaces": [
    "client",
    "schema",
    "server",
    "server-core",
    "tests"
  ],
  "scripts": {
    "build": "tsc -b && npm run build -w @sugarcube/client",
    "clean": "tsc -b --clean",
    "dev:client": "npm run dev -w @sugarcube/client",
    "client-tests": "npm run test -w @sugarcube/tests",
    "local-up": "docker compose -f server/docker/local/docker-compose.yml up -d --wait",
    "local-down": "docker compose -f server/docker/local/docker-compose.yml down",
    "typecheck": "tsc -b --pretty false && npm run typecheck -w @sugarcube/client"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@types/node": "^24.10.1",
    "typescript": "^5.9.3"
  }
}
