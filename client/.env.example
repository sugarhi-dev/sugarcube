# Identity provider. Defaults match the local Keycloak realm.
VITE_KEYCLOAK_ISSUER=http://localhost/idp/realms/sugarcube
VITE_KEYCLOAK_CLIENT_ID=sugarcube

# Leave empty in development so the Vite dev server proxies /api to the API on port 3000.
VITE_API_BASE_URL=

# The local Keycloak client expects this redirect URI:
# http://localhost/sugarhi/auth/callback
