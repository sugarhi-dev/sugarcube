{
  "name": "@sugarcube/client",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "predev": "npm run build -w @sugarcube/schema",
    "build": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.node.json --noEmit && vite build",
    "prebuild": "npm run build -w @sugarcube/schema",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit --pretty false && tsc -p tsconfig.node.json --noEmit --pretty false",
    "pretypecheck": "npm run build -w @sugarcube/schema"
  },
  "dependencies": {
    "@ant-design/icons": "^6.3.4",
    "@reduxjs/toolkit": "^2.13.0",
    "@sugarcube/schema": "0.0.0",
    "antd": "^6.6.8",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-redux": "^9.3.1",
    "react-router": "^7.6.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "^5.9.3",
    "vite": "^7.0.0"
  }
}
